PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/taskdb
# Use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
# Cache time-to-live in seconds, and a switch to measure uncached response times
CACHE_TTL=60
CACHE_ENABLED=true
# Simulated slow notification handler (ms)
NOTIFY_DELAY_MS=2000
